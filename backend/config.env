DATABASE_URL=sqlite:///./tineai_poc.db
SECRET_KEY=super-secret-poc-key-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=480
UPLOAD_DIR=./uploads

# HuggingFace — cache dir (models download here once, never re-downloaded)
HF_HUB_CACHE=D:\hf_cache\hub
HUGGINGFACE_HUB_CACHE=D:\hf_cache\hub
TRANSFORMERS_CACHE=D:\hf_cache\hub

# HuggingFace token — required for pyannote gated models
HF_TOKEN=

# Celery (only needed when running the worker separately)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
